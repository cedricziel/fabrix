opt_out_usage

APP_IDENTIFIER = "com.cedricziel.fabrix"
APP_NAME       = "Fabrix"
TEAM_ID        = "WPW3QSLZ2F"
PROJECT        = "Fabrix.xcodeproj"
OUTPUT_DIR     = "build/fastlane"
REPO_ROOT      = File.expand_path("..", __dir__)
PUBLIC_BETA_GROUP = "Public beta"
PRIVACY_URL    = "https://github.com/cedricziel/fabrix/blob/main/PRIVACY.md"

TARGETS = {
  ios: {
    target: "FabrixiOS",
    match_platform: "ios",
    upload_platform: "ios",
    review_platform: "IOS",
    destination: "generic/platform=iOS",
    artifact: "#{OUTPUT_DIR}/Fabrix.ipa",
  },
  mac: {
    target: "FabrixMac",
    match_platform: "macos",
    upload_platform: "osx",
    review_platform: "MAC_OS",
    destination: "generic/platform=macOS",
    artifact: "#{OUTPUT_DIR}/Fabrix.pkg",
  },
}.freeze

# Build number = commits reachable from HEAD: monotonic on main, never written back.
def commit_count_build_number
  @commit_count_build_number ||= sh("git rev-list --count HEAD", log: false).strip
end

def marketing_version(options)
  explicit = options[:version].to_s.strip
  return explicit unless explicit.empty?

  File.read(File.join(REPO_ROOT, "project.yml"))[/MARKETING_VERSION:\s*"([^"]+)"/, 1]
end

before_all do |_lane, _options|
  Dotenv.load(".env") if File.exist?(".env")
  # Without setup_ci, codesign on macOS runners hangs on a keychain prompt.
  setup_ci if is_ci
end

platform :ios do
  desc "Build a signed App Store IPA (iPhone + iPad) without uploading"
  lane :build do |options|
    build_target(:ios, options)
  end

  desc "Build and upload to TestFlight"
  lane :release do |options|
    release_target(:ios, options)
  end
end

platform :mac do
  desc "Build a signed Mac App Store PKG without uploading"
  lane :build do |options|
    build_target(:mac, options)
  end

  desc "Build and upload to TestFlight"
  lane :release do |options|
    release_target(:mac, options)
  end
end

desc "Register the bundle ID in the developer portal (idempotent)"
lane :register_bundle_id do
  load_app_store_connect_api_key
  existing = Spaceship::ConnectAPI::BundleId.find(APP_IDENTIFIER)
  if existing
    UI.success("Bundle ID #{APP_IDENTIFIER} already registered (#{existing.platform})")
  else
    Spaceship::ConnectAPI::BundleId.create(name: APP_NAME, platform: "UNIVERSAL", identifier: APP_IDENTIFIER)
    UI.success("Registered #{APP_IDENTIFIER}")
  end
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  if app
    UI.success("App Store Connect app exists: #{app.name} (#{app.id})")
  else
    UI.important("No App Store Connect app for #{APP_IDENTIFIER} yet. Create it in App Store Connect (iOS + macOS).")
  end
end

desc "Create the public TestFlight group (idempotent) and print its join link"
lane :setup_public_beta do
  load_app_store_connect_api_key
  group = public_beta_group
  UI.success("Public beta link: #{group.public_link}")
end

desc "Send an uploaded build to the public beta group and submit it for Beta App Review"
desc "  platform:ios|mac  build:<number> (default: the latest build for that platform)"
lane :distribute_public_beta do |options|
  t = TARGETS.fetch(options[:platform].to_s == "mac" ? :mac : :ios)
  api_key = load_app_store_connect_api_key
  public_beta_group
  beta = public_beta_params
  UI.user_error!("Set REVIEW_CONTACT_* to distribute to the public beta") if beta.empty?
  expire_builds_waiting_for_review(t[:review_platform])
  upload_to_testflight(**beta.merge(
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    app_platform: t[:upload_platform],
    distribute_only: true,
    build_number: options[:build],
    app_version: options[:version] || (options[:build] ? nil : marketing_version({}))
  ))
end

desc "Update the TestFlight test information (description, feedback email, privacy URL) without a build"
desc "  privacy_url:<url>  override the privacy policy URL"
lane :sync_beta_info do |options|
  load_app_store_connect_api_key
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER) || UI.user_error!("No App Store Connect app for #{APP_IDENTIFIER}")
  attributes = {
    description: beta_description,
    privacyPolicyUrl: options[:privacy_url] || PRIVACY_URL
  }
  email = ENV["REVIEW_CONTACT_EMAIL"].to_s.strip
  attributes[:feedbackEmail] = email unless email.empty?
  existing = Spaceship::ConnectAPI.get_beta_app_localizations(filter: { app: app.id }).to_models
  localization = existing.find { |l| l.locale == "en-US" }
  if localization
    Spaceship::ConnectAPI.patch_beta_app_localizations(localization_id: localization.id, attributes: attributes)
  else
    Spaceship::ConnectAPI.post_beta_app_localizations(app_id: app.id, attributes: attributes.merge(locale: "en-US"))
  end
  UI.success("Updated the TestFlight test information")
end

desc "Create App Store signing certs and profiles for iOS and macOS via match (writes to the certificates repo)"
lane :bootstrap_signing do |options|
  api_key = load_app_store_connect_api_key
  %w[ios macos].each do |platform|
    params = {
      type: "appstore",
      platform: platform,
      app_identifier: [APP_IDENTIFIER],
      readonly: false,
      force: options[:force].to_s == "true",
      api_key: api_key
    }
    params[:additional_cert_types] = ["mac_installer_distribution"] if platform == "macos"
    match(**params)
  end
end

def build_target(key, options)
  t = TARGETS.fetch(key)
  api_key = load_app_store_connect_api_key
  version = marketing_version(options)
  build_number = commit_count_build_number

  UI.header("#{APP_NAME} #{key} #{version} (#{build_number})")

  match_params = {
    type: "appstore",
    platform: t[:match_platform],
    app_identifier: [APP_IDENTIFIER],
    readonly: is_ci,
    api_key: api_key
  }
  match_params[:additional_cert_types] = ["mac_installer_distribution"] if key == :mac
  sync_code_signing(**match_params)

  # The project is generated, so signing settings go onto a fresh copy.
  sh("cd #{REPO_ROOT.shellescape} && xcodegen generate")

  update_code_signing_settings(
    path: PROJECT,
    targets: [t[:target]],
    build_configurations: ["Release"],
    use_automatic_signing: false,
    team_id: TEAM_ID,
    code_sign_identity: "Apple Distribution",
    bundle_identifier: APP_IDENTIFIER,
    profile_name: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING].fetch(APP_IDENTIFIER)
  )

  build_app(
    project: PROJECT,
    scheme: t[:target],
    configuration: "Release",
    destination: t[:destination],
    export_method: "app-store",
    export_team_id: TEAM_ID,
    output_directory: OUTPUT_DIR,
    output_name: APP_NAME,
    clean: true,
    include_symbols: true,
    xcargs: "MARKETING_VERSION=#{version.shellescape} CURRENT_PROJECT_VERSION=#{build_number.shellescape}"
  )

  { version: version, build_number: build_number }
end

def release_target(key, options)
  t = TARGETS.fetch(key)
  built = build_target(key, options)
  notes_file = ENV["RELEASE_NOTES_FILE"].to_s
  notes = File.read(notes_file).strip if !notes_file.empty? && File.exist?(notes_file)

  api_key = load_app_store_connect_api_key
  public_beta_group
  beta = public_beta_params
  expire_builds_waiting_for_review(t[:review_platform]) unless beta.empty?
  params = beta.merge(
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    app_platform: t[:upload_platform],
    # Distributing to an external group needs the build processed first.
    skip_waiting_for_build_processing: beta.empty?,
    changelog: notes.to_s.empty? ? "Build #{built[:version]} (#{built[:build_number]})" : notes
  )
  params[key == :mac ? :pkg : :ipa] = t[:artifact]

  upload_to_testflight(**params)
end

def public_beta_group
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER) || UI.user_error!("No App Store Connect app for #{APP_IDENTIFIER}")
  app.get_beta_groups.find { |g| g.name == PUBLIC_BETA_GROUP } ||
    app.create_beta_group(
      group_name: PUBLIC_BETA_GROUP,
      is_internal_group: false,
      public_link_enabled: true,
      public_link_limit: 10_000,
      public_link_limit_enabled: true
    )
end

# Beta App Review accepts one waiting submission per version and platform, and
# iOS and macOS share a version, so only this platform's waiting builds expire.
def expire_builds_waiting_for_review(platform)
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER) || UI.user_error!("No App Store Connect app for #{APP_IDENTIFIER}")
  app.get_builds(
    filter: {
      "betaAppReviewSubmission.betaReviewState" => "WAITING_FOR_REVIEW",
      "expired" => false,
      "preReleaseVersion.platform" => platform
    },
    includes: "betaAppReviewSubmission,preReleaseVersion"
  ).each do |build|
    UI.important("Expiring #{platform} build #{build.version}, which is still waiting for Beta App Review")
    build.expire!
  end
end

def beta_description
  File.read(File.join(__dir__, "metadata", "beta", "description.txt")).strip
end

def public_beta_params
  description = beta_description
  params = {
    wait_processing_timeout_duration: 1800,
    distribute_external: true,
    groups: [PUBLIC_BETA_GROUP],
    notify_external_testers: true,
    submit_beta_review: true,
    demo_account_required: false,
    beta_app_description: description,
    localized_app_info: {
      "default" => { description: description, privacy_policy_url: PRIVACY_URL },
      "en-US" => { description: description, privacy_policy_url: PRIVACY_URL }
    }
  }
  contact = %w[REVIEW_CONTACT_FIRST_NAME REVIEW_CONTACT_LAST_NAME REVIEW_CONTACT_PHONE REVIEW_CONTACT_EMAIL].map { |k| ENV[k].to_s.strip }
  if contact.any?(&:empty?)
    UI.important("REVIEW_CONTACT_* not set: builds go to internal testers only")
    return {}
  end
  first, last, phone, email = contact
  params[:beta_app_feedback_email] = email
  params[:localized_app_info].each_value { |info| info[:feedback_email] = email }
  params[:beta_app_review_info] = {
    contact_first_name: first,
    contact_last_name: last,
    contact_phone: phone,
    contact_email: email,
    demo_account_required: false,
    notes: File.read(File.join(__dir__, "metadata", "beta", "review_notes.txt")).strip
  }
  params
end

def load_app_store_connect_api_key
  return @asc_api_key if @asc_api_key

  env = ->(name) {
    value = ENV[name]
    value.nil? || value.strip.empty? ? nil : value
  }
  key_id      = env.call("ASC_KEY_ID")
  issuer_id   = env.call("ASC_ISSUER_ID")
  key_path    = env.call("ASC_KEY_PATH")
  key_content = env.call("ASC_KEY_CONTENT")

  if key_id.nil? || issuer_id.nil? || (key_path.nil? && key_content.nil?)
    UI.user_error!(<<~MSG)
      Missing App Store Connect API key configuration. Set ASC_KEY_ID,
      ASC_ISSUER_ID and either ASC_KEY_PATH or ASC_KEY_CONTENT.
      Locally: copy fastlane/.env.default to fastlane/.env, or run via `op run`.
      In CI:   they are GitHub Actions secrets (scripts/setup-ci-secrets.sh).
    MSG
  end

  params = { key_id: key_id, issuer_id: issuer_id, in_house: false }
  if key_path
    params[:key_filepath] = key_path
  else
    params[:key_content] = key_content
    params[:is_key_content_base64] =
      key_content.match?(/\A[A-Za-z0-9+\/=\s]+\z/) && !key_content.include?("BEGIN PRIVATE KEY")
  end
  @asc_api_key = app_store_connect_api_key(**params)
end

error do |lane, exception|
  UI.error("Lane #{lane} failed: #{exception.message}")
end
